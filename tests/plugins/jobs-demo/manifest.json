{
  "id": "jobs-demo",
  "name": "Jobs demo (test only)",
  "icon": "flask",
  "version": "0.1.0",
  "api_version": 1,
  "kinds": [
    { "id": "demo-notes", "storage": { "hidden": true }, "claimed_text": true, "schema": { "type": "object" } }
  ],
  "operations": [
    {
      "id": "jobs-demo.list",
      "input_schema": {
        "type": "object",
        "properties": {
          "kind": { "type": "string" },
          "cursor": { "type": "string" },
          "label": { "type": "string" },
          "limit": { "type": "integer" }
        },
        "required": ["kind"],
        "additionalProperties": false
      },
      "output_schema": { "type": "object" },
      "required_capability": "space.read",
      "mutates": false,
      "idempotency": "read_only", "risk": "read"
    },
    {
      "id": "jobs-demo.write",
      "input_schema": { "type": "object", "properties": { "text": { "type": "string", "maxLength": 1024 } }, "required": ["text"], "additionalProperties": false },
      "output_schema": { "type": "object", "properties": { "id": { "type": "string" } }, "required": ["id"], "additionalProperties": false },
      "required_capability": "content.write",
      "mutates": true,
      "idempotency": "request_id", "risk": "reversible"
    },
    {
      "id": "jobs-demo.start",
      "input_schema": {
        "type": "object",
        "properties": {
          "steps": { "type": "integer", "minimum": 0, "maximum": 1000 },
          "delay_ms": { "type": "integer", "minimum": 0, "maximum": 1000 },
          "every": { "type": "integer", "minimum": 1, "maximum": 1000 },
          "children": { "type": "integer", "minimum": 0, "maximum": 8 },
          "value": { "type": "integer" },
          "wait": { "enum": ["deadline", "question", "approval", "webhook"] },
          "deadline_ms": { "type": "integer" },
          "correlation": { "type": "string" }
        },
        "required": ["steps", "delay_ms", "every"],
        "additionalProperties": false
      },
      "output_schema": { "type": "object", "properties": { "job_id": { "type": "string" } }, "required": ["job_id"] },
      "required_capability": "plugins.use",
      "mutates": true,
      "idempotency": "request_id", "risk": "reversible"
    },
    {
      "id": "jobs-demo.run",
      "input_schema": {
        "type": "object",
        "properties": { "job_id": { "type": "string" }, "input": { "type": "object" }, "checkpoint": {}, "children": { "type": "array" }, "signal": { "type": "object" } },
        "required": ["job_id", "input", "checkpoint", "children"],
        "additionalProperties": false
      },
      "output_schema": { "type": "object", "properties": { "status": { "enum": ["done", "waiting", "parked"] } }, "required": ["status"] },
      "required_capability": "plugins.use",
      "mutates": false,
      "idempotency": "read_only", "risk": "read"
    }
  ],
  "collections": [],
  "views": [],
  "attention": [],
  "settings": [],
  "schedules": [],
  "webhooks": [{"id":"delivery","operation":"jobs-demo.write"}],
  "secrets": ["delivery"],
  "hooks": [],
  "themes": [],
  "host_calls": ["write_item", "list_items_v1", "start_job", "checkpoint_job", "request_secret_handle"]
}
