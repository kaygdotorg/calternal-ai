<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Lets Core Animation and display links run at the full ProMotion rate (120 Hz) instead of 60. -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- One scene, no storyboard; AppDelegate names the delegate class. -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict/>
	</dict>
	<!-- Launch screen: one colour, light or dark with the system, matching the page's first paint. -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<!-- calternal:// opens the app (the share page's "Open" link); calternal://<path> opens that path of the web app. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>cloud.calternal.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>calternal</string>
			</array>
		</dict>
	</array>
	<!-- Lets the web view open plain-http development addresses (the fixtures build on the VPN). Weakens transport security for page content: restrict to development builds before release. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<key>NSAllowsArbitraryLoadsInWebContent</key>
		<true/>
	</dict>
</dict>
</plist>
