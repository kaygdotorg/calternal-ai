<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- calternal:// opens the app; calternal://<path> opens that path of the web app. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>cloud.calternal.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>calternal</string>
			</array>
		</dict>
	</array>
	<!-- Lets the web view open plain-http development addresses. Weakens transport security for page content: restrict to development builds before release. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoadsInWebContent</key>
		<true/>
	</dict>
</dict>
</plist>
