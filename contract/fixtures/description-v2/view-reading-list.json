{
  "version": 2,
  "kind": "view",
  "revision": 1,
  "title": "Reading list",
  "binds": [
    {
      "id": "items",
      "source": {
        "type": "list",
        "kind": "reading-item"
      },
      "fields": [
        "title",
        "added",
        "read"
      ],
      "sort": [
        {
          "field": "added",
          "direction": "desc"
        }
      ],
      "window": {
        "size": 60,
        "count": "exact"
      },
      "row": {
        "title": {
          "field": "title"
        },
        "icon": {
          "kindIcon": true
        },
        "marks": [
          {
            "kind": "icon",
            "icon": "check",
            "tone": "good",
            "when": {
              "field": "read",
              "op": "eq",
              "value": {
                "literal": true
              }
            }
          }
        ],
        "trailingActions": [
          {
            "id": "mark-read",
            "title": "Mark read",
            "icon": "check",
            "operation": "reading.mark-read",
            "inputs": {
              "item": {
                "row": "id"
              }
            },
            "tone": "good",
            "fullSwipe": true
          }
        ]
      },
      "states": {
        "empty": {
          "title": "Nothing to read yet",
          "detail": "Add the first link above."
        }
      }
    },
    {
      "id": "reminders",
      "source": {
        "type": "list",
        "kind": "reading-reminder"
      },
      "fields": [
        "title",
        "due",
        "person"
      ],
      "filter": {
        "all": [
          {
            "field": "person",
            "op": "eq",
            "value": {
              "viewer": "person"
            }
          }
        ]
      },
      "sort": [
        {
          "field": "due",
          "direction": "asc"
        }
      ],
      "window": {
        "size": 20,
        "count": "exact"
      },
      "row": {
        "title": {
          "field": "title"
        },
        "icon": {
          "kindIcon": true
        },
        "marks": [
          {
            "kind": "text",
            "field": "due",
            "tone": "warn"
          }
        ]
      },
      "states": {
        "empty": {
          "title": "No reminders"
        }
      }
    }
  ],
  "root": {
    "type": "stack",
    "title": "Reading list",
    "children": [
      {
        "type": "form",
        "id": "add",
        "title": "Add a link",
        "fields": [
          {
            "id": "title",
            "label": "Title",
            "input": "text",
            "required": true,
            "maxLength": 120
          },
          {
            "id": "url",
            "label": "Address",
            "input": "url",
            "required": true,
            "maxLength": 500
          }
        ],
        "submit": {
          "id": "add",
          "title": "Add",
          "operation": "reading.add",
          "inputs": {
            "title": {
              "form": "add",
              "field": "title"
            },
            "url": {
              "form": "add",
              "field": "url"
            }
          },
          "result": {
            "show": [
              "pending",
              "error"
            ]
          }
        }
      },
      {
        "type": "list",
        "bind": "items",
        "selectable": true,
        "title": "To read"
      },
      {
        "type": "form",
        "id": "remind",
        "title": "Remind me (only I see this)",
        "fields": [
          {
            "id": "when",
            "label": "When",
            "input": "date",
            "required": true
          },
          {
            "id": "note",
            "label": "Note",
            "input": "text",
            "maxLength": 120
          }
        ],
        "submit": {
          "id": "remind",
          "title": "Set reminder",
          "operation": "reading.remind",
          "inputs": {
            "item": {
              "selection": "items"
            },
            "when": {
              "form": "remind",
              "field": "when"
            },
            "note": {
              "form": "remind",
              "field": "note"
            }
          },
          "preview": {
            "material": [
              "item"
            ]
          }
        }
      },
      {
        "type": "list",
        "bind": "reminders",
        "title": "My reminders"
      }
    ]
  }
}