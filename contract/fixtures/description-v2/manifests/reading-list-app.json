{
  "description": "Fixture manifest for the reading-list exercise: a subset of plugin-manifest-v2 (the plugin's kinds with typed indexed fields and audiences, the operations with titles and inputs). The full manifest is validated by the plugins lane.",
  "kinds": {
    "reading-item": {
      "fields": {
        "added": {
          "type": "Timestamp"
        },
        "read": {
          "type": "Boolean"
        },
        "title": {
          "type": "Text"
        }
      },
      "icon": "book",
      "title_field": "title"
    },
    "reading-reminder": {
      "fields": {
        "due": {
          "type": "Timestamp"
        },
        "person": {
          "type": "AccountRef",
