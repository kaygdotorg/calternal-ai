    },
    {
      "required_capability": "plugins.use",
      "risk": "external",
      "idempotency": "request_id",
      "id": "threads.arm",
      "title": "Schedule a run",
      "target": {
        "kind": "threads",
        "field": "item"
      },
      "methods": [
        "item_head",
        "item_range",
        "item_spans",
        "alarm_set"
