          "message": {
            "type": "string",
            "pattern": "^(?:[0-9a-f]{16}|[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12})$"
          },
          "offset": {
            "type": "integer",
