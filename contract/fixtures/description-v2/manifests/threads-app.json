      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "item": {
            "$ref": "host-catalogue-v2.json#/$defs/ItemRef"
          },
          "text": {
            "type": "string",
            "minLength": 1,
