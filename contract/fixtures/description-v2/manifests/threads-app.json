        "type": "object",
        "additionalProperties": false,
        "properties": {
          "item": {
            "$ref": "host-catalogue-v2.json#/$defs/ItemRef"
          },
          "if_missed": {
            "enum": [
              "run",
              "skip"
            ]
          }
        },
        "required": [
          "item"
        ]
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {},
