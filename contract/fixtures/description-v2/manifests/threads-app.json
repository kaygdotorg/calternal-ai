      "risk": "external",
      "idempotency": "request_id",
      "id": "threads.run",
      "title": "Run agent",
      "target": {
        "kind": "threads",
        "field": "item"
      },
      "methods": [
        "item_head",
        "item_range",
        "item_spans",
        "item_append",
        "item_save",
        "item_save_begin",
        "item_save_chunk",
        "item_save_seal",
        "execution_start",
        "contribution_call",
        "contribution_read",
        "item_view_context",
        "item_view_publish"
