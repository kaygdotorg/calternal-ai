{
  "api_version": 2,
  "id": "calternal-threads",
  "name": "Threads",
  "version": "0.1.0",
  "icon": "threads",
  "kinds": [
    {
      "id": "thread-consultations",
      "icon": "threads",
      "title_field": "title",
      "storage": {
        "hidden": true
      },
      "claimed_text": true,
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "required": [
          "title"
        ]
      }
    },
    {
      "id": "threads",
      "icon": "threads",
      "title_field": "title",
      "storage": {
        "folder": "Threads"
      },
      "claimed_text": true,
      "searchable": true,
      "file_format": {
        "id": "calternal-thread",
        "version": 2,
        "default_app": "threads",
        "title_binding": {
          "placement": "utc_date_folder",
          "frontmatter_key": "title"
        },
        "metadata_tokens": [
          {
            "scope": "frontmatter_key",
            "prefix": "format"
          },
          {
            "scope": "frontmatter_key",
            "prefix": "id"
          },
          {
            "scope": "frontmatter_line",
            "prefix": "participants:"
          },
          {
            "scope": "frontmatter_line",
            "prefix": "  - p"
          },
          {
            "scope": "frontmatter_key",
            "prefix": "agent-p",
            "suffix": "-plugin"
          },
          {
            "scope": "frontmatter_key",
            "prefix": "agent-p",
            "suffix": "-harness"
          },
          {
            "scope": "framing_suffix",
            "prefix": " {#m-",
            "suffix": "}"
          },
          {
            "scope": "framing_line",
            "prefix": "<!-- run-log=",
            "suffix": " -->"
          },
          {
            "scope": "framing_line",
            "prefix": "<!-- consultation=",
            "suffix": " -->"
          },
          {
            "scope": "framing_line",
            "prefix": "<!-- reply-in=",
            "suffix": " -->"
          }
        ]
      },
      "append_file": true,
      "attempt_discovery": "item_policy",
      "execution_target": true,
      "view_snapshots": [
        {
          "id": "body",
          "refresh": "threads.refresh"
        }
      ],
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "shape": {
            "enum": [
              "person",
              "group",
              "agent",
              "mixed"
            ]
          }
        },
        "required": [
          "title"
        ]
      },
      "indexed_fields": {
        "shape": {
          "type": "Text",
          "audience": "shared_projection"
        }
      },
      "viewer_fields": {
        "preview": {
          "type": "Text"
        },
        "unread": {
          "type": "Number",
          "source": "entry_unread"
        },
        "mentions": {
          "type": "Number",
          "source": "entry_mentions"
        },
        "muted": {
          "type": "Boolean"
        },
        "pinned": {
          "type": "Boolean"
        },
        "draft": {
          "type": "Text"
        },
        "unread_mark": {
          "type": "Boolean"
        }
      }
    }
  ],
  "jobs": [
    {
      "id": "run",
      "run_operation": "threads.run",
      "replayable": true,
      "execution": true,
      "alarm": true
    }
  ],
  "network": "none",
