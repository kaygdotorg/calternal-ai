{
  "$comment": "The Notes plugin as an ordinary plugin: its own kind and operations; collections, trash and sharing are host built-ins (the catalogue).",
  "id": "notes",
  "reads": [
    "collections"
  ],
  "kinds": {
    "notes": {
      "icon": "notes",
      "title_field": "title",
      "indexed_fields": {
        "title": {
          "type": "Text",
          "audience": "member_item",
          "nullable": false
        },
        "updated": {
          "type": "Timestamp",
          "audience": "member_item",
          "nullable": false
        },
        "pinned": {
          "type": "Boolean",
          "audience": "member_item",
          "nullable": false
        },
        "trashed": {
          "type": "Boolean",
          "audience": "member_item",
          "nullable": false
        },
        "trashed_at": {
          "type": "Timestamp",
          "audience": "member_item",
          "nullable": true
        },
        "collection": {
          "type": "CollectionRef",
          "audience": "member_item",
          "nullable": false
        }
      }
    }
  },
  "operations": {
    "notes.create": {
      "title": "New note",
      "risk": "reversible",
      "idempotency": "request_id",
      "inputs": [
        "collection"
      ],
      "creates": "notes"
    },
    "notes.remind": {
      "title": "Remind me",
      "risk": "reversible",
      "idempotency": "request_id",
      "inputs": [
        "item",
        "when"
      ]
    },
    "notes.move": {
      "title": "Move to collection",
      "risk": "reversible",
      "idempotency": "request_id",
      "inputs": [
        "item",
        "collection"
      ]
    }
  }
}