{
  "version": 2,
  "revision": 1,
  "scheme": "dark",
  "cache": {
    "policy": "account",
    "maxAgeDays": 14
  },
  "binds": [
    {
      "id": "waiting",
      "source": {
        "type": "list",
        "kind": "thread"
      },
      "fields": [
        "title",
        "provider",
        "state",
        "updated"
      ],
      "filter": {
        "all": [
          {
            "field": "waiting_on",
            "op": "eq",
            "value": {
              "viewer": "person"
            }
          }
        ]
      },
      "sort": [
        {
          "field": "updated",
          "direction": "desc"
        }
      ],
      "window": {
        "size": 60,
        "count": "exact"
      },
      "row": {
        "title": {
          "field": "title"
        },
        "icon": {
          "field": "provider",
          "map": {
            "claude": "claude",
            "codex": "codex"
          }
        },
        "marks": [
          {
            "kind": "dot",
            "when": {
              "field": "state",
              "op": "eq",
              "value": {
                "literal": "waiting"
              }
            }
          },
          {
            "kind": "icon",
            "icon": "warning",
            "tone": "bad",
            "when": {
              "field": "state",
              "op": "eq",
              "value": {
                "literal": "failed"
              }
            }
          }
        ],
        "open": {
          "route": {
            "name": "thread",
            "value": "id"
          }
        },
        "trailingActions": [
          {
            "id": "archive",
            "title": "Archive",
            "icon": "trash",
            "operation": "host.item.trash",
            "inputs": {
              "item": {
                "row": "id"
              }
            },
            "role": "destructive",
            "result": {
              "show": [
                "pending",
                "error",
                "undo"
              ]
            }
          }
        ]
      },
      "states": {
        "empty": {
          "title": "Nothing is waiting on you"
        }
      }
    },
    {
      "id": "all",
      "source": {
        "type": "list",
        "kind": "thread"
      },
      "fields": [
        "title",
        "provider",
        "state",
        "updated"
      ],
      "sort": [
        {
          "field": "updated",
          "direction": "desc"
        }
      ],
      "window": {
        "size": 60,
        "count": "exact"
      },
      "row": {
        "title": {
          "field": "title"
        },
        "icon": {
          "field": "provider",
          "map": {
            "claude": "claude",
            "codex": "codex"
          }
        },
        "marks": [
          {
            "kind": "dot",
            "when": {
              "field": "state",
              "op": "eq",
              "value": {
                "literal": "waiting"
              }
            }
          }
        ],
        "open": {
          "route": {
            "name": "thread",
            "value": "id"
          }
        }
      }
    },
    {
      "id": "requests",
      "source": {
        "type": "list",
        "kind": "request"
      },
      "fields": [
        "title",
        "thread"
      ],
      "filter": {
        "all": [
          {
            "field": "pending_for",
            "op": "eq",
            "value": {
              "viewer": "person"
            }
          }
        ]
      },
      "window": {
        "size": 3,
        "count": "exact"
      }
    },
    {
      "id": "thread",
      "source": {
        "type": "item",
        "kind": "thread",
        "ref": {
          "route": "thread"
        }
      },
      "fields": [
        "title"
      ]
    }
  ],
  "sidebar": {
    "open": true,
    "title": "Calternal",
    "cards": [
      {
        "id": "approval",
        "title": "Waiting on you",
        "tone": "warn",
        "icon": "warning",
        "when": {
          "bind": "requests"
        },
        "primary": {
          "id": "open-request",
          "title": "Review",
          "operation": "host.route.set",
          "inputs": {
            "thread": {
              "bind": "requests",
              "field": "thread"
            }
          }
        }
      }
    ],
    "selectors": [
      {
        "id": "filter",
        "route": "view",
        "selected": "inbox",
        "options": [
          {
            "id": "inbox",
            "title": "Inbox",
            "count": {
              "bind": "waiting"
            }
          },
          {
            "id": "all",
            "title": "All Threads"
          }
        ]
      }
    ],
    "sections": [
      {
        "id": "shortcuts",
        "rows": [
          {
            "id": "new-thread",
            "title": "New thread",
            "icon": "plus",
            "open": {
              "invoke": {
                "id": "create",
                "title": "New thread",
                "operation": "threads.create",
                "inputs": {},
                "retry": "keyed"
              }
            }
          }
        ]
      },
      {
        "id": "inbox",
        "title": "Waiting on you",
        "bind": "waiting",
        "showWhen": {
          "route": "view",
          "equals": "inbox"
        }
      },
      {
        "id": "threads",
        "title": "Threads",
        "bind": "all",
        "showWhen": {
          "route": "view",
          "equals": "all"
        }
      }
    ]
  },
  "header": {
    "title": {
      "bind": "thread",
      "field": "title"
    }
  },
  "footer": {
    "account": {
      "id": "account",
      "initial": "K",
      "title": "Account"
    },
    "apps": [
      {
        "id": "threads",
        "title": "Threads",
        "icon": "threads"
      },
      {
        "id": "notes",
        "title": "Notes",
        "icon": "notes"
      }
    ],
    "search": {
      "placeholder": "Search threads"
    }
  },
  "panel": {
    "id": "side-chat",
    "title": "Side chat",
    "open": true,
    "components": [
      {
        "type": "turn-transcript",
        "id": "transcript",
        "config": {
          "thread": {
            "route": "thread"
          }
        }
      },
      {
        "type": "request-card",
        "id": "approval-card",
        "config": {
          "request": {
            "bind": "requests",
            "field": "id"
          }
        }
      },
      {
        "type": "composer",
        "id": "composer",
        "config": {
          "placeholder": "Ask about this thread",
          "enabled": {
            "literal": true
          },
          "send": {
            "id": "send",
            "title": "Send",
            "operation": "turns.start",
            "inputs": {
              "thread": {
                "route": "thread"
              },
              "text": {
                "draft": "composer"
              }
            },
            "retry": "keyed",
            "result": {
              "show": [
                "pending",
                "error"
              ]
            }
          }
        }
      }
    ]
  }
}