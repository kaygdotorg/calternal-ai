{
  "version": 2,
  "kind": "view",
  "revision": 1,
  "binds": [
    {
      "id": "waiting",
      "source": {
        "type": "list",
        "kind": "requests"
      },
      "fields": [
        "title",
        "thread_ref"
      ],
      "filter": {
        "all": [
          {
            "field": "pending_for",
            "op": "eq",
            "value": {
              "viewer": "person"
            }
          },
          {
            "field": "thread_ref",
            "op": "eq",
            "value": {
              "route": "thread"
            }
          }
        ]
      },
      "window": {
        "size": 5,
        "count": "exact"
      },
      "row": {
        "title": {
          "field": "title"
        },
        "icon": {
          "kindIcon": true
        }
      }
    }
  ],
  "root": {
    "type": "stack",
    "children": [
      {
        "type": "component",
        "component": {
          "type": "turn-transcript",
          "id": "transcript",
          "config": {
            "thread": {
              "route": "thread"
            },
            "follow": "end",
            "quote": true
          }
        }
      },
      {
        "type": "component",
        "component": {
          "type": "request-card",
          "id": "approval",
          "config": {
            "request": {
              "bind": "waiting",
              "field": "id"
            }
          }
        }
      },
      {
        "type": "component",
        "component": {
          "type": "composer",
          "id": "composer",
          "config": {
            "target": {
              "route": "thread"
            },
            "placeholder": "Message",
            "attachments": true,
            "mentions": true,
            "send": {
              "id": "send",
              "title": "Send",
              "operation": "turns.start",
              "inputs": {
                "thread": {
                  "route": "thread"
                },
                "text": {
                  "draft": "composer"
                }
              },
              "result": {
                "show": [
                  "pending",
                  "error"
                ]
              }
            },
            "stop": true,
            "controls": [
              {
                "id": "provider",
                "label": "Agent",
                "kind": "choice",
                "options": {
                  "source": "providers"
                },
                "required": true
              },
              {
                "id": "model",
                "label": "Model",
                "kind": "choice",
                "options": {
                  "source": "models",
                  "dependsOn": "provider"
                }
              },
              {
                "id": "reasoning",
                "label": "Reasoning",
                "kind": "choice",
                "options": {
                  "source": "reasoning",
                  "dependsOn": "model"
                }
              }
            ]
          }
        }
      }
    ]
  }
}