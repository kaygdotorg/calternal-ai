{
  "version": 2,
  "revision": 1,
  "binds": [
    {
      "id": "items",
      "source": {
        "type": "list",
        "kind": "reading-item"
      },
      "fields": [
        "title",
        "added",
        "read"
      ],
      "sort": [
        {
          "field": "added",
          "direction": "desc"
        }
      ],
      "window": {
        "size": 60,
        "count": "exact"
      },
      "row": {
        "title": {
          "field": "title"
        },
        "icon": {
          "kindIcon": true
        },
        "marks": [
          {
            "kind": "icon",
            "icon": "check",
            "tone": "good",
            "when": {
              "field": "read",
              "op": "eq",
              "value": {
                "literal": true
              }
            }
          }
        ],
        "trailingActions": [
          {
            "id": "mark-read",
            "title": "Mark read",
            "icon": "check",
            "operation": "reading.mark-read",
            "inputs": {
              "item": {
                "row": "id"
              }
            },
            "tone": "good",
            "fullSwipe": true
          }
        ]
      },
      "states": {
        "empty": {
          "title": "Nothing to read",
          "detail": "Add a link below."
        }
      }
    }
  ],
  "sidebar": {
    "open": true,
    "title": "Reading list",
    "sections": [
      {
        "id": "items",
        "title": "To read",
        "bind": "items"
      }
    ]
  },
  "header": {
    "title": "Reading list"
  }
}