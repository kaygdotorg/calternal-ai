{
  "version": 2,
  "kind": "app",
  "revision": 1,
  "binds": [
    {
      "id": "waiting",
      "source": {
        "type": "list",
        "kind": "threads"
      },
      "fields": [
        "title",
        "provider",
        "state",
        "updated"
      ],
      "filter": {
        "all": [
          {
            "field": "waiting_on",
            "op": "eq",
            "value": {
              "viewer": "person"
            }
          }
        ]
      },
      "sort": [
        {
          "field": "updated",
          "direction": "desc"
        }
      ],
      "window": {
        "size": 60,
        "count": "exact"
      },
      "row": {
        "title": {
          "field": "title"
        },
        "icon": {
          "field": "provider",
          "map": {
            "calternal-claude-code": "claude",
            "calternal-codex": "codex"
          }
        },
        "marks": [
          {
            "kind": "dot",
            "when": {
              "field": "state",
              "op": "eq",
              "value": {
                "literal": "waiting"
              }
            }
          },
          {
            "kind": "icon",
            "icon": "warning",
            "tone": "bad",
            "when": {
              "field": "state",
              "op": "eq",
              "value": {
                "literal": "failed"
              }
            }
          }
        ],
        "open": {
          "route": {
            "name": "thread",
            "value": "id"
          }
        },
        "trailingActions": [
          {
            "id": "archive",
            "title": "Archive",
            "icon": "trash",
            "operation": "turns.archive",
            "inputs": {
              "thread": {
                "row": "id"
              }
            },
            "role": "destructive"
          }
        ]
      },
      "states": {
        "empty": {
          "title": "Nothing is waiting on you"
        }
      }
    },
    {
      "id": "all",
      "source": {
        "type": "list",
        "kind": "threads"
      },
      "fields": [
        "title",
        "provider",
        "state",
        "updated"
      ],
      "sort": [
        {
          "field": "updated",
          "direction": "desc"
        }
      ],
      "window": {
        "size": 60,
        "count": "exact"
      },
      "row": {
        "title": {
          "field": "title"
        },
        "icon": {
          "field": "provider",
          "map": {
            "calternal-claude-code": "claude",
            "calternal-codex": "codex"
          }
        },
        "marks": [
          {
            "kind": "dot",
            "when": {
              "field": "state",
              "op": "eq",
              "value": {
                "literal": "waiting"
              }
            }
          }
        ],
        "open": {
          "route": {
            "name": "thread",
            "value": "id"
          }
        }
      }
    },
    {
      "id": "requests",
      "source": {
        "type": "list",
        "kind": "requests"
      },
      "fields": [
        "title",
        "thread_ref"
      ],
      "filter": {
        "all": [
          {
            "field": "pending_for",
            "op": "eq",
            "value": {
              "viewer": "person"
            }
          }
        ]
      },
      "window": {
        "size": 3,
        "count": "exact"
      }
    },
    {
      "id": "thread",
      "source": {
        "type": "item",
        "kind": "threads",
        "ref": {
          "route": "thread"
        }
      },
      "fields": [
        "title"
      ]
    }
  ],
  "cache": {
    "maxAgeDays": 14,
    "templates": "keep"
  },
  "chrome": {
    "sidebar": {
      "open": true,
      "title": "Calternal",
      "selectors": [
        {
          "id": "filter",
          "route": "view",
          "selected": "inbox",
          "options": [
            {
              "id": "inbox",
              "title": "Inbox",
              "count": {
                "bind": "waiting"
              }
            },
            {
              "id": "all",
              "title": "All Threads"
            }
          ]
        }
      ],
      "sections": [
        {
          "id": "shortcuts",
          "rows": [
            {
              "id": "new-thread",
              "title": "New thread",
              "icon": "plus",
              "open": {
                "invoke": {
                  "id": "create",
                  "title": "New thread",
                  "operation": "turns.create",
                  "inputs": {}
                }
              }
            }
          ]
        },
        {
          "id": "inbox",
          "title": "Waiting on you",
          "bind": "waiting",
          "showWhen": {
            "route": "view",
            "equals": "inbox"
          }
        },
        {
          "id": "threads",
          "title": "Threads",
          "bind": "all",
          "showWhen": {
            "route": "view",
            "equals": "all"
          }
        }
      ]
    },
    "header": {
      "title": {
        "bind": "thread",
        "field": "title"
      }
    },
    "footer": {
      "account": {
        "id": "account",
        "title": "Account"
      },
      "apps": [
        {
          "id": "threads",
          "title": "Threads",
          "icon": "threads"
        },
        {
          "id": "notes",
          "title": "Notes",
          "icon": "notes"
        }
      ],
      "search": {
        "placeholder": "Search threads"
      }
    },
    "panel": {
      "id": "side-chat",
      "title": "Side chat",
      "open": true,
      "components": [
        {
          "type": "turn-transcript",
          "id": "transcript",
          "config": {
            "thread": {
              "route": "thread"
            }
          }
        },
        {
          "type": "request-card",
          "id": "approval-card",
          "config": {
            "request": {
              "bind": "requests",
              "field": "id"
            }
          }
        },
        {
          "type": "composer",
          "id": "composer",
          "config": {
            "placeholder": "Ask about this thread",
            "enabled": {
              "literal": true
            },
            "thread": {
              "route": "thread"
            }
          }
        }
      ]
    }
  },
  "view": {
    "root": {
      "type": "stack",
      "children": [
        {
          "type": "component",
          "component": {
            "type": "turn-transcript",
            "id": "transcript",
            "config": {
              "thread": {
                "route": "thread"
              },
              "follow": "end",
              "quote": true
            }
          }
        },
        {
          "type": "component",
          "component": {
            "type": "request-card",
            "id": "approval",
            "config": {
              "request": {
                "bind": "waiting",
                "field": "id"
              }
            }
          }
        },
        {
          "type": "component",
          "component": {
            "type": "composer",
            "id": "composer",
            "config": {
              "placeholder": "Message",
              "attachments": true,
              "mentions": true,
              "stop": true,
              "controls": [
                {
                  "id": "provider",
                  "label": "Agent",
                  "kind": "choice",
                  "options": {
                    "source": "providers"
                  },
                  "required": true
                },
                {
                  "id": "model",
                  "label": "Model",
                  "kind": "choice",
                  "options": {
                    "source": "models"
                  }
                },
                {
                  "id": "reasoning",
                  "label": "Reasoning",
                  "kind": "choice",
                  "options": {
                    "source": "reasoning"
                  }
                }
              ],
              "thread": {
                "route": "thread"
              }
            }
          }
        }
      ]
    }
  }
}