{
  "version": 2,
  "revision": 1,
  "scheme": "dark",
  "cache": {
    "templates": "keep"
  },
  "binds": [
    {
      "id": "collections",
      "source": {
        "type": "list",
        "kind": "collections"
      },
      "fields": [
        "title"
      ],
      "sort": [
        {
          "field": "title",
          "direction": "asc"
        }
      ],
      "window": {
        "size": 100,
        "count": "exact"
      },
      "row": {
        "title": {
          "field": "title"
        },
        "icon": {
          "kindIcon": true
        },
        "open": {
          "route": {
            "name": "collection",
            "value": "id"
          }
        }
      },
      "states": {
        "empty": {
          "title": "No collections yet"
        }
      }
    },
    {
      "id": "notes",
      "source": {
        "type": "list",
        "kind": "notes",
        "collection": {
          "route": "collection"
        }
      },
      "fields": [
        "title",
        "updated",
        "pinned"
      ],
      "filter": {
        "all": [
          {
            "field": "trashed",
            "op": "eq",
            "value": {
              "literal": false
            }
          }
        ]
      },
      "sort": [
        {
          "field": "updated",
          "direction": "desc"
        }
      ],
      "window": {
        "size": 60,
        "count": "exact"
      },
      "row": {
        "title": {
          "field": "title",
          "fallback": "Untitled"
        },
        "icon": {
          "kindIcon": true
        },
        "marks": [
          {
            "kind": "icon",
            "icon": "spark",
            "when": {
              "field": "pinned",
              "op": "eq",
              "value": {
                "literal": true
              }
            }
          }
        ],
        "open": {
          "route": {
            "name": "item",
            "value": "id"
          }
        },
        "leadingActions": [
          {
            "id": "pin",
            "title": "Pin",
            "icon": "spark",
            "operation": "notes.pin",
            "inputs": {
              "item": {
                "row": "id"
              }
            },
            "tone": "warn"
          }
        ],
        "trailingActions": [
          {
            "id": "trash",
            "title": "Trash",
            "icon": "trash",
            "operation": "host.item.trash",
            "inputs": {
              "item": {
                "row": "id"
              }
            },
            "role": "destructive",
            "result": {
              "show": [
                "pending",
                "error",
                "undo"
              ]
            }
          }
        ],
        "menu": [
          {
            "id": "rename",
            "title": "Rename",
            "icon": "edit",
            "operation": "host.item.rename",
            "inputs": {
              "item": {
                "row": "id"
              },
              "title": {
                "prompt": {
                  "title": "Rename note",
                  "initial": {
                    "row": "field",
                    "field": "title"
                  }
                }
              }
            },
            "preview": {
              "material": [
                "item"
              ]
            },
            "result": {
              "show": [
                "pending",
                "error",
                "undo"
              ]
            }
          }
        ]
      },
      "states": {
        "empty": {
          "title": "No notes here",
          "detail": "Create one to get started."
        },
        "error": {
          "title": "Notes could not load",
          "action": {
            "id": "retry",
            "title": "Try again",
            "shell": {
              "reload": true
            }
          }
        }
      }
    },
    {
      "id": "trash",
      "source": {
        "type": "list",
        "kind": "notes"
      },
      "fields": [
        "title",
        "trashed_at"
      ],
      "filter": {
        "all": [
          {
            "field": "trashed",
            "op": "eq",
            "value": {
              "literal": true
            }
          }
        ]
      },
      "sort": [
        {
          "field": "trashed_at",
          "direction": "desc"
        }
      ],
      "window": {
        "size": 60,
        "count": "exact"
      },
      "row": {
        "title": {
          "field": "title",
          "fallback": "Untitled"
        },
        "icon": {
          "kindIcon": true
        },
        "selectable": true,
        "trailingActions": [
          {
            "id": "restore",
            "title": "Restore",
            "icon": "check",
            "operation": "host.item.restore",
            "inputs": {
              "item": {
                "row": "id"
              }
            },
            "tone": "good"
          }
        ]
      },
      "states": {
        "empty": {
          "title": "Trash is empty"
        }
      }
    },
    {
      "id": "trash-count",
      "source": {
        "type": "list",
        "kind": "notes"
      },
      "fields": [],
      "filter": {
        "all": [
          {
            "field": "trashed",
            "op": "eq",
            "value": {
              "literal": true
            }
          }
        ]
      },
      "window": {
        "size": 1,
        "count": "exact"
      }
    }
  ],
  "sidebar": {
    "open": true,
    "title": "Calternal",
    "selectors": [
      {
        "id": "view",
        "route": "view",
        "selected": "notes",
        "options": [
          {
            "id": "notes",
            "title": "Notes"
          },
          {
            "id": "trash",
            "title": "Trash",
            "count": {
              "bind": "trash-count"
            }
          }
        ]
      }
    ],
    "sections": [
      {
        "id": "shortcuts",
        "rows": [
          {
            "id": "new-note",
            "title": "New note",
            "icon": "plus",
            "open": {
              "invoke": {
                "id": "create",
                "title": "New note",
                "operation": "notes.create",
                "inputs": {
                  "collection": {
                    "route": "collection"
                  }
                }
              }
            }
          }
        ]
      },
      {
        "id": "collections",
        "title": "Collections",
        "bind": "collections",
        "showWhen": {
          "route": "view",
          "equals": "notes"
        }
      },
      {
        "id": "notes",
        "title": "Notes",
        "bind": "notes",
        "showWhen": {
          "route": "view",
          "equals": "notes"
        }
      },
      {
        "id": "trash",
        "title": "Trash",
        "bind": "trash",
        "showWhen": {
          "route": "view",
          "equals": "trash"
        },
        "actions": [
          {
            "id": "empty-trash",
            "title": "Empty Trash",
            "icon": "trash",
            "role": "destructive",
            "shell": {
              "sheet": "trash"
            }
          }
        ]
      }
    ],
    "refresh": true
  },
  "footer": {
    "account": {
      "id": "account",
      "initial": "K",
      "title": "Account",
      "menu": [
        {
          "id": "signout",
          "title": "Sign out",
          "role": "destructive",
          "shell": {
            "signOut": true
          }
        }
      ]
    },
    "apps": [
      {
        "id": "threads",
        "title": "Threads",
        "icon": "threads"
      },
      {
        "id": "notes",
        "title": "Notes",
        "icon": "notes"
      },
      {
        "id": "settings",
        "title": "Settings",
        "icon": "settings"
      }
    ],
    "search": {
      "placeholder": "Search notes"
    }
  },
  "header": {
    "title": {
      "bind": "notes",
      "field": "title"
    },
    "trailing": [
      {
        "id": "share",
        "title": "Share",
        "icon": "share",
        "shell": {
          "sheet": "share",
          "item": {
            "route": "item"
          }
        }
      }
    ]
  }
}