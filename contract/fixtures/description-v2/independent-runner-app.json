{
  "version": 2,
  "kind": "app",
  "revision": 1,
  "binds": [
    {
      "id": "conversations",
      "source": {
        "type": "list",
        "kind": "lantern-conversation"
      },
      "fields": [
        "title",
        "state"
      ],
      "row": {
        "title": {
          "field": "title"
        },
        "menu": [
          {
            "id": "archive",
            "title": "Archive",
            "operation": "host.item.archive",
            "inputs": {
              "item": {
                "context": "item"
              }
            }
          }
        ]
      }
    }
  ],
  "chrome": {
    "header": {
      "title": "Lantern",
      "trailing": [
        {
          "id": "new",
          "title": "New conversation",
          "operation": "host.item.create",
          "inputs": {
            "kind": {
              "literal": "lantern-conversation"
            }
          }
        }
      ]
    }
  },
  "view": {
    "root": {
      "type": "component",
      "component": {
        "type": "item-view",
        "id": "messages",
        "config": {
          "item": {
            "route": "item"
          },
          "slot": "body"
        }
      }
    }
  }
}
