{
  "version": 2,
  "kind": "app",
  "revision": 1,
  "binds": [
    {
      "id": "layout",
      "source": {
        "type": "list",
        "kind": "layout_sections"
      },
      "fields": [
        "title"
      ],
      "row": {
        "title": {
          "field": "title"
        }
      }
    },
    {
      "id": "t",
      "source": {
        "type": "list",
        "kind": "chats",
        "parent": true
      },
      "fields": [
        "title"
      ],
      "row": {
        "title": {
          "field": "title"
        },
        "menu": [
          {
            "id": "mv",
            "title": "Move to",
            "operation": "host.layout.move_to",
            "inputs": {
              "section": {
                "prompt": {
                  "title": "Move to",
                  "kind": "choice",
                  "options": {
                    "bind": "layout"
                  }
                }
              },
              "item": {
                "route": "chat"
              }
            }
          }
        ]
      }
    }
  ],
  "chrome": {
    "sidebar": {
      "sections": [
        {
          "id": "by-section",
          "repeat": {
            "over": "layout",
            "rows": "t"
          }
        }
      ]
    }
  }
}
