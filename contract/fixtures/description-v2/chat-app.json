{
  "version": 2,
  "kind": "app",
  "revision": 1,
  "view": {
    "root": {
      "type": "stack",
      "children": [
        {
          "type": "form",
          "id": "create",
          "fields": [
            {
              "id": "title",
              "label": "Title",
              "input": "text",
              "required": true
            }
          ],
          "submit": {
            "id": "create-chat",
            "title": "New chat",
            "operation": "chat.create",
            "inputs": {
              "title": {
                "form": "create",
                "field": "title"
              }
            },
            "then": {
              "route": {
                "name": "item"
              }
            }
          }
        },
        {
          "type": "component",
          "component": {
            "type": "item-view",
            "id": "transcript",
            "config": {
              "item": {
                "route": "item"
              },
              "slot": "body"
            }
          }
        },
        {
          "type": "form",
          "id": "composer",
          "entry_context": {
            "component": "transcript"
          },
          "fields": [
            {
              "id": "message",
              "label": "Message",
              "input": "multiline",
              "required": true,
              "maxLength": 4000,
              "draft": {
                "slot": "draft"
              }
            }
          ],
          "submit": {
            "id": "send",
            "title": "Send",
            "operation": "chat.send",
            "inputs": {
              "item": {
                "route": "item"
              },
              "text": {
                "form": "composer",
                "field": "message"
              },
              "harness": {
                "prompt": {
                  "title": "Agent",
                  "kind": "choice",
                  "options": {
                    "extension": "harnesses"
                  }
                }
              },
              "placement": {
                "prompt": {
                  "title": "Run on",
                  "kind": "choice",
                  "options": {
                    "host": "execution_placement"
                  }
                }
              }
            }
          }
        },
        {
          "type": "form",
          "id": "rename",
          "fields": [
            {
              "id": "title",
              "label": "Title",
              "input": "text",
              "required": true
            }
          ],
          "submit": {
            "id": "rename-chat",
            "title": "Rename",
            "operation": "host.item.rename",
            "inputs": {
              "item": {
                "route": "item"
              },
              "title": {
                "form": "rename",
                "field": "title"
              }
            }
          }
        },
        {
          "type": "button",
          "invoke": {
            "id": "archive-chat",
            "title": "Archive",
            "operation": "host.item.archive",
            "inputs": {
              "item": {
                "route": "item"
              }
            }
          }
        }
      ]
    }
  }
}
