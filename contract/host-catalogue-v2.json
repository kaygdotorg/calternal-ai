{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calternal.cloud/contract/host-catalogue-v2.json",
  "description": "Review contract for host kinds, operations, query limits and the activation exchange. A reference shape conveys no authority. The host semantic loader still validates scope, profiles, contracts and dependencies.",
  "reserved_operation_prefixes": [
    "host.",
    "turns."
  ],
  "audiences": {
    "member_item": "Live item authority and field policy on the member path.",
    "shared_projection": "Member authority or a host-approved explicit projection for this guest's home root/children. Counts require a separate projection flag.",
    "viewer_self": "Member may address only their own value. In filters only eq with viewer.person. No general readback, sort, aggregation or access to another person's value.",
    "designated_request_actor": "Host-private request addressed to the designated viewer. Covers only the referenced eligible request. No guest list or count. A row id resolves only to a checked RequestRef."
  },
  "kinds": {
    "notes": {
      "owner": "content",
      "row_ref": "ItemRef",
      "audience": "member_item",
      "fields": {
        "id": {
          "type": "ItemRef",
          "index_owner": "content",
          "audience": "shared_projection",
          "nullable": false
        },
        "title": {
          "type": "Text",
          "index_owner": "content",
          "audience": "shared_projection",
          "nullable": false
        },
        "updated": {
          "type": "Timestamp",
          "index_owner": "content",
          "audience": "shared_projection",
          "nullable": false
        },
        "pinned": {
          "type": "Boolean",
