    "host.approval.resolve": {
      "engine": "protected Inbox resolver",
      "effect": "widens_access",
      "idempotency": "request_id",
      "authority": "Designated approver with current grant",
      "surfaces": [
        "protected_request_card"
      ],
      "generic_invoke": false,
      "full_swipe": false,
      "worker_wake": "never",
      "target_inputs": [
        "request"
      ],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request",
          "decision"
        ],
        "properties": {
          "request": {
            "$ref": "#/$defs/RequestRef"
          },
          "decision": {
            "enum": [
              "approve",
              "deny"
            ]
          },
          "lifetime": {
            "enum": [
              "once",
              "this_thread"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "decision": {
                  "const": "approve"
                }
              }
            },
            "then": {
              "required": [
                "lifetime"
              ]
            },
            "else": {
              "properties": {
                "lifetime": false
              }
            }
          }
        ]
      },
      "outcome_schema": {
        "$ref": "#/$defs/ActionOutcome"
      },
      "outcomes": [
        "ok",
        "stale",
        "refused",
        "error",
        "unknown",
        "unknown",
        "unknown"
      ]
    },
