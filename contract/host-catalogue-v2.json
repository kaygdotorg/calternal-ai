          "nullable": false
        },
        "updated": {
          "type": "Timestamp",
          "index_owner": "turns",
          "audience": "shared_projection",
          "nullable": false
        },
        "provider": {
          "type": "ProviderId",
          "index_owner": "turns",
          "audience": "member_item",
          "nullable": false,
