          "audience": "member_item",
          "nullable": false
        },
        "trashed": {
          "type": "Boolean",
          "index_owner": "content",
          "audience": "member_item",
          "nullable": false
        },
        "trashed_at": {
          "type": "Timestamp",
          "index_owner": "content",
          "audience": "member_item",
          "nullable": true
        }
      },
      "search_corpora": [
        "member_title",
        "member_body",
        "shared_titles"
      ],
      "icon": "notes"
    },
    "collections": {
      "owner": "content",
      "row_ref": "CollectionRef",
      "audience": "member_item",
      "fields": {
        "id": {
          "type": "CollectionRef",
          "index_owner": "content",
          "audience": "shared_projection",
          "nullable": false
        },
        "title": {
          "type": "Text",
          "index_owner": "content",
          "audience": "shared_projection",
          "nullable": false
        },
        "updated": {
          "type": "Timestamp",
          "index_owner": "content",
          "audience": "shared_projection",
          "nullable": false
        },
        "trashed": {
          "type": "Boolean",
          "index_owner": "content",
          "audience": "member_item",
          "nullable": false
        },
        "trashed_at": {
          "type": "Timestamp",
          "index_owner": "content",
          "audience": "member_item",
          "nullable": true
        }
      },
      "search_corpora": [
        "member_title",
        "shared_titles"
      ],
      "icon": "folder"
    },
    "threads": {
      "owner": "turns",
      "row_ref": "ThreadRef",
      "audience": "member_item",
      "fields": {
        "id": {
          "type": "ThreadRef",
          "index_owner": "turns",
          "audience": "shared_projection",
          "nullable": false
        },
        "title": {
          "type": "Text",
          "index_owner": "turns",
