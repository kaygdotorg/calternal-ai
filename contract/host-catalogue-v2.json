  "query": {
    "operators": {
      "eq": "Same scalar type or an explicitly nullable field compared to null.",
      "ne": "Same scalar type; available only for a bounded indexed complement.",
      "in": "One to 32 homogeneous scalars of the field type; no coercion or nested list.",
      "lt": "Ordered indexed number, timestamp or approved collation key.",
      "lte": "Same as lt.",
      "gt": "Same as lt.",
      "gte": "Same as lt.",
      "exists": "No operand. Tests indexed non-null presence; use equality with null on nullable fields for absence.",
      "prefix": "Nonempty text normalized with the field's indexed collation; up to 128 UTF-8 bytes."
    },
    "filter_groups": [
      "all",
      "any"
    ],
    "max_predicates": 16,
    "max_sort_fields": 2,
    "tie_breaker": "id",
    "count_modes": {
      "exact": "Count of the authorized projection at its checked result version; guest requires explicit count permission.",
      "estimate": "Audience-certified member estimate only; refuse when unavailable.",
      "none": "Omit count."
    },
    "window": {
      "request_schema": {
        "$ref": "#/$defs/WindowRequest"
      },
      "result_schema": {
        "$ref": "#/$defs/WindowResult"
      },
      "max_rows": 200,
      "default_rows": 60,
      "max_offset": 100000,
      "max_encoded_bytes": 131072,
      "max_request_span": 200
    },
    "unsupported_plan": {
      "status": 422,
      "code": "unsupported_query_plan"
    },
    "live_limits": {
      "binds_per_view": 16,
      "subscriptions_per_view": 8,
      "subscriptions_per_actor": 16,
      "subscriptions_per_space": 128,
      "pending_windows_per_view": 2,
      "queued_bytes_per_view": 262144,
      "queued_bytes_per_actor": 524288,
      "queued_bytes_per_space": 8388608,
      "query_starts_per_view_per_second": 8,
      "query_starts_per_actor_per_second": 16,
      "query_starts_per_space_per_second": 64,
      "live_updates_per_bind_per_second": 4,
      "index_visits_per_window": 4096,
      "index_visits_per_count": 100000,
      "count_starts_per_space_per_second": 4,
      "pending_windows_per_actor": 4,
      "pending_windows_per_space": 32,
      "query_concurrency_per_space": 8,
      "subscriber_session_lease_seconds": 15
    },
    "cross_bind_operands": "Forbidden in the first query slice. Action and component references to upstream fields still require one authorized projected row and a checked dependency edge."
  },
  "$defs": {
    "Ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "ActionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "ActivationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "ContextRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "ProofRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "Text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "Boolean": {
      "type": "boolean"
    },
    "Number": {
      "type": "number"
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time",
      "maxLength": 40
    },
    "KindId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "CollectionRef": {
      "$ref": "#/$defs/Ref",
      "description": "Opaque host-authorized CollectionRef reference. A compatible string shape does not grant authority."
    },
    "ThreadRef": {
      "$ref": "#/$defs/Ref",
      "description": "Opaque host-authorized ThreadRef reference. A compatible string shape does not grant authority."
    },
    "TurnRef": {
      "$ref": "#/$defs/Ref",
      "description": "Opaque host-authorized TurnRef reference. A compatible string shape does not grant authority."
    },
    "RequestRef": {
      "$ref": "#/$defs/Ref",
      "description": "Opaque host-authorized RequestRef reference. A compatible string shape does not grant authority."
    },
    "AccountRef": {
      "$ref": "#/$defs/Ref",
      "description": "Opaque host-authorized AccountRef reference. A compatible string shape does not grant authority."
    },
    "AttachmentRef": {
      "$ref": "#/$defs/Ref",
      "description": "Opaque host-authorized AttachmentRef reference. A compatible string shape does not grant authority."
    },
    "StatusRef": {
      "$ref": "#/$defs/Ref",
      "description": "Opaque host-authorized StatusRef reference. A compatible string shape does not grant authority."
    },
    "UndoRef": {
      "$ref": "#/$defs/Ref",
      "description": "Opaque host-authorized UndoRef reference. A compatible string shape does not grant authority."
    },
    "TrashSelectionRef": {
      "$ref": "#/$defs/Ref",
      "description": "Opaque host-authorized TrashSelectionRef reference. A compatible string shape does not grant authority."
    },
    "DestinationFrameRef": {
      "$ref": "#/$defs/Ref",
      "description": "Opaque host-authorized DestinationFrameRef reference. A compatible string shape does not grant authority."
    },
    "RevisionRef": {
      "$ref": "#/$defs/Ref",
      "description": "Opaque host-authorized RevisionRef reference. A compatible string shape does not grant authority."
    },
    "QuoteRef": {
      "$ref": "#/$defs/Ref",
      "description": "Opaque host-authorized QuoteRef reference. A compatible string shape does not grant authority."
    },
    "ItemRef": {
      "$ref": "#/$defs/Ref",
      "description": "Typed host reference for the declared kind and target. A scoped row may carry it; client markup cannot create it."
    },
    "Quote": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "thread",
        "quote_ref"
      ],
      "properties": {
        "thread": {
          "$ref": "#/$defs/ThreadRef"
        },
        "quote_ref": {
          "$ref": "#/$defs/QuoteRef"
        }
      }
    },
    "Draft": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "text": {
          "type": "string",
          "maxLength": 65536
        },
        "attachments": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/AttachmentRef"
          }
        },
        "mentions": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/AccountRef"
          }
        },
        "quote": {
          "$ref": "#/$defs/Quote"
        }
      }
    },
    "Interaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "form": {
          "type": "object",
          "maxProperties": 32
        },
        "prompt": {
          "type": "object",
          "maxProperties": 8
        },
        "draft": {
          "$ref": "#/$defs/Draft"
        },
        "selection_ref": {
          "$ref": "#/$defs/Ref"
        }
      }
    },
    "ResolveActivation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "action_id",
        "activation_id",
        "activation_context"
      ],
      "properties": {
        "type": {
          "const": "invoke"
        },
        "action_id": {
          "$ref": "#/$defs/ActionId"
        },
        "activation_id": {
          "$ref": "#/$defs/ActivationId"
        },
        "activation_context": {
          "$ref": "#/$defs/ContextRef"
        },
        "interaction": {
          "$ref": "#/$defs/Interaction"
        }
      }
    },
    "ConfirmActivation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "activation_id",
        "resolution_ref",
        "confirmation_challenge"
      ],
      "properties": {
        "type": {
          "const": "invoke_confirm"
        },
        "activation_id": {
          "$ref": "#/$defs/ActivationId"
        },
        "resolution_ref": {
          "$ref": "#/$defs/ContextRef"
        },
        "confirmation_challenge": {
          "$ref": "#/$defs/ProofRef"
        }
      }
    },
    "DispatchActivation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "activation_id",
        "resolution_ref"
      ],
      "properties": {
        "type": {
          "const": "invoke_dispatch"
        },
        "activation_id": {
          "$ref": "#/$defs/ActivationId"
        },
        "resolution_ref": {
          "$ref": "#/$defs/ContextRef"
        },
        "confirmation_proof": {
          "$ref": "#/$defs/ProofRef"
        }
      }
    },
    "ConfirmationMaterial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "label",
        "value"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/Text"
        },
        "label": {
          "$ref": "#/$defs/Text"
        },
        "value": {}
      }
    },
    "ActivationResolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activation_id",
        "resolution_ref"
      ],
      "properties": {
        "activation_id": {
          "$ref": "#/$defs/ActivationId"
        },
        "resolution_ref": {
          "$ref": "#/$defs/ContextRef"
        },
        "confirmation_challenge": {
          "$ref": "#/$defs/ProofRef"
        },
        "material": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/ConfirmationMaterial"
          }
        }
      },
      "dependentRequired": {
        "confirmation_challenge": [
          "material"
        ],
        "material": [
          "confirmation_challenge"
        ]
      }
    },
    "UndoResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "label",
        "expires_at"
      ],
      "properties": {
        "ref": {
          "$ref": "#/$defs/UndoRef"
        },
        "label": {
          "$ref": "#/$defs/Text"
        },
        "expires_at": {
          "$ref": "#/$defs/Timestamp"
        }
      }
    },
    "ActionOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activation_id",
        "state"
      ],
      "properties": {
        "activation_id": {
          "$ref": "#/$defs/ActivationId"
        },
        "state": {
          "enum": [
            "ok",
            "pending",
            "error",
            "stale",
            "refused",
            "unknown"
          ]
        },
        "status_ref": {
          "$ref": "#/$defs/StatusRef"
        },
        "undo": {
          "$ref": "#/$defs/UndoResult"
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "pending"
              }
            }
          },
          "then": {
            "required": [
              "status_ref"
            ]
          },
          "else": {
            "properties": {
              "status_ref": false
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "ok"
              }
            }
          },
          "else": {
            "properties": {
              "undo": false
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "error",
                  "refused",
                  "stale",
                  "unknown"
                ]
              }
            }
          },
          "then": {
            "required": [
              "code",
              "message"
            ]
          },
          "else": {
            "properties": {
              "code": false,
              "message": false
            }
          }
        }
      ]
    },
    "WindowRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "to": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100200
        },
        "from": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        }
      }
    },
    "WindowRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "fields"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Ref"
        },
        "fields": {
          "type": "object",
          "maxProperties": 32
        }
      }
    },
    "WindowResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result_version",
        "offset",
        "rows"
      ],
      "properties": {
        "result_version": {
          "$ref": "#/$defs/Ref"
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "rows": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/WindowRow"
          }
        },
        "count": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "value"
          ],
          "properties": {
            "mode": {
              "enum": [
                "exact",
                "estimate"
              ]
            },
            "value": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "ProviderId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "description": "Installed provider identifier. Known built-in IDs are icon-map seeds, not a closed allowlist."
    },
    "TranscriptCursor": {
      "$ref": "#/$defs/Ref",
      "description": "Opaque, checked cursor for a thread and committed event position."
    },
    "TranscriptPageRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "thread"
      ],
      "properties": {
        "thread": {
          "$ref": "#/$defs/ThreadRef"
        },
        "after": {
          "$ref": "#/$defs/TranscriptCursor"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        }
      }
    },
    "CommittedTranscriptEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "kind",
        "data"
      ],
      "properties": {
        "event_id": {
          "$ref": "#/$defs/Ref"
        },
        "kind": {
          "$ref": "#/$defs/Text"
        },
        "data": {
          "type": "object",
          "description": "Host-owned typed event from the admitted Turns schema."
        }
      }
    },
    "TranscriptPage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "events",
        "committed_cursor"
      ],
      "properties": {
        "events": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/CommittedTranscriptEvent"
          }
        },
        "committed_cursor": {
          "$ref": "#/$defs/TranscriptCursor"
        }
      }
    },
    "SealedFrameOpen": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame"
      ],
      "properties": {
        "frame": {
          "$ref": "#/$defs/DestinationFrameRef"
        }
      }
    },
    "SealedFrameResize": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame",
        "height"
      ],
      "properties": {
        "frame": {
          "$ref": "#/$defs/DestinationFrameRef"
        },
        "height": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        }
      }
    },
    "SealedFrameOpenLink": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame",
        "link_ref"
      ],
      "properties": {
        "frame": {
          "$ref": "#/$defs/DestinationFrameRef"
        },
        "link_ref": {
          "$ref": "#/$defs/Ref"
        }
      }
    }
  },
  "activation_limits": {
    "context_seconds": 30,
    "per_viewer": 256,
    "per_space": 4096,
    "resolve_interaction_encoded_bytes": 131072
  },
  "component_routes": {
    "transcript.page": {
      "input_schema": {
        "$ref": "#/$defs/TranscriptPageRequest"
      },
      "output_schema": {
        "$ref": "#/$defs/TranscriptPage"
      },
      "encoded_page_bytes": 131072,
      "scope": "Authorized thread and current audience"
    },
    "sealed_frame.open": {
      "input_schema": {
        "$ref": "#/$defs/SealedFrameOpen"
      },
      "scope": "Authorized committed revision and current audience",
      "max_ref_seconds": 300
    },
    "sealed_frame.resize": {
      "input_schema": {
        "$ref": "#/$defs/SealedFrameResize"
      },
      "scope": "Trusted wrapper for the current frame"
    },
    "sealed_frame.open_link": {
      "input_schema": {
        "$ref": "#/$defs/SealedFrameOpenLink"
      },
      "scope": "Host link ID from the current frame, with fresh route authorization"
    }
  }
}
