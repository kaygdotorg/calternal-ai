{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://calternal.cloud/contract/plugin-manifest-v2.schema.json",
  "title": "Calternal plugin manifest v2",
  "description": "Revision 14.16 draft. Runtime enablement follows qualification. Validate offline with the versioned contract registry. Uniqueness, references, digest verification and approval are separate host checks.",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "id", "name", "version", "icon", "apps", "kinds", "operations", "network"],
  "properties": {
    "api_version": { "const": 2 },
    "id": { "$ref": "#/definitions/localId" },
    "name": { "$ref": "#/definitions/label" },
    "version": { "type": "string", "minLength": 5, "maxLength": 64, "description": "Validated as a semantic version by the host." },
    "icon": { "$ref": "#/definitions/icon" },
    "worker": { "$ref": "#/definitions/asset" },
    "apps": { "type": "array", "maxItems": 16, "items": { "$ref": "#/definitions/app" } },
    "kinds": { "type": "array", "maxItems": 64, "items": { "$ref": "#/definitions/kind" } },
    "operations": { "type": "array", "maxItems": 128, "items": { "$ref": "#/definitions/operation" } },
    "reads": {
      "description": "Kinds an authored Bind can query. The SDK adds the package’s own kinds to the emitted list. Authors declare only kinds owned by another app or the host. Show the emitted list at install and intersect with current viewer and field authority.",
      "type": "array", "maxItems": 64, "uniqueItems": true,
      "items": { "$ref": "host-catalogue-v2.json#/$defs/KindId" }
    },
    "jobs": { "type": "array", "maxItems": 32, "items": { "$ref": "#/definitions/job" } },
    "wait_webhooks": { "type": "array", "maxItems": 32, "items": { "$ref": "#/definitions/webhook" } },
    "settings": { "type": "array", "maxItems": 64, "items": { "$ref": "#/definitions/setting" } },
    "secrets": { "type": "array", "maxItems": 32, "items": { "$ref": "#/definitions/secret" } },
    "credential_routes": { "type": "array", "maxItems": 32, "items": { "$ref": "#/definitions/credentialRoute" } },
    "content_fetch": { "const": true, "description": "Render remote images through the host's anonymous image proxy. Grants no worker network access and excludes the package from noNetworkBadge." },
    "network": {
      "oneOf": [
        { "const": "none", "description": "Deny every worker egress route. Derive badge and filter eligibility using noNetworkBadge." },
        {
          "type": "object", "additionalProperties": false, "minProperties": 1, "maxProperties": 3,
          "properties": {
            "fixed_sites": {
              "description": "Exact HTTPS hosts accepted at install by a Manager or Owner.",
              "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true,
              "items": { "$ref": "#/definitions/hostname" }
            },
            "user_servers": { "const": true, "description": "Use public HTTPS servers the acting person has added in account setup." },
            "any_website": { "const": true, "description": "Use public HTTPS with an Owner-approved install warning." }
          }
        }
      ]
    },
    "contributions": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/definitions/contribution"
      }
    }
  },
  "if": {
    "anyOf": [
      { "properties": { "operations": { "minItems": 1 } } },
      { "required": ["jobs"], "properties": { "jobs": { "minItems": 1 } } },
      { "required": ["wait_webhooks"], "properties": { "wait_webhooks": { "minItems": 1 } } },
      { "required": ["credential_routes"], "properties": { "credential_routes": { "minItems": 1 } } },
      {
        "required": ["contributions"],
        "properties": {
          "contributions": {
            "minItems": 1
          }
        }
      }
    ]
  },
  "then": { "required": ["worker"] },
  "allOf": [
    {
      "if": { "properties": { "network": { "const": "none" } } },
      "then": {
        "properties": {
          "operations": {
            "items": { "properties": { "methods": { "not": { "contains": { "enum": ["proxy_request", "credential_call", "request_secret_handle"] } } } } }
          }
        }
      }
    },
    {
      "if": { "required": ["credential_routes"], "properties": { "credential_routes": { "minItems": 1 } } },
      "then": {
        "required": ["secrets"],
        "properties": {
          "secrets": { "minItems": 1 },
          "network": { "type": "object", "anyOf": [{ "required": ["fixed_sites"] }, { "required": ["user_servers"] }] }
        }
      }
    }
  ],
  "definitions": {
    "noNetworkBadge": { "$ref": "host-catalogue-v2.json#/$defs/NoNetworkBadgeManifest" },
    "windowRequest": { "$ref": "host-catalogue-v2.json#/$defs/WindowRequest" },
    "localId": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*(?![\\s\\S])", "maxLength": 64 },
    "operationId": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z][a-z0-9_-]*)+(?![\\s\\S])", "maxLength": 128 },
    "label": { "type": "string", "minLength": 1, "maxLength": 128 },
    "path": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|(?![\\s\\S])))[A-Za-z0-9_-][A-Za-z0-9._-]*(?:/[A-Za-z0-9_-][A-Za-z0-9._-]*)*(?![\\s\\S])" },
    "asset": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": { "path": { "$ref": "#/definitions/path" }, "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}(?![\\s\\S])" } }
    },
    "icon": {
      "oneOf": [
        { "$ref": "#/definitions/localId" },
        { "type": "object", "additionalProperties": false, "required": ["image"],
          "properties": { "image": { "$ref": "#/definitions/asset" } } }
      ],
      "description": "A catalogue icon or a checked bundled PNG/JPEG."
    },
    "embeddedSchema": {
      "description": "An inline Draft 7 schema or boolean. Host compiles it offline using only registered references.",
      "type": ["object", "boolean"]
    },
    "description": {
      "type": "object", "additionalProperties": false, "required": ["id", "template"],
      "properties": {
        "id": { "$ref": "#/definitions/localId" },
        "template": { "$ref": "#/definitions/asset" }
      }
    },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "icon", "description"],
      "properties": {
        "id": { "$ref": "#/definitions/localId" },
        "name": { "$ref": "#/definitions/label" },
        "icon": { "$ref": "#/definitions/icon" },
        "description": { "$ref": "#/definitions/description" },
        "extension_points": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/definitions/extensionPoint"
          }
        }
      }
    },
    "kind": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "icon", "title_field", "storage", "claimed_text", "schema"],
      "properties": {
        "id": { "$ref": "host-catalogue-v2.json#/$defs/KindId" },
        "icon": { "$ref": "#/definitions/icon" },
        "title_field": { "$ref": "#/definitions/localId", "description": "Ordinary string metadata exposed as the generic title. Declare the named property directly in schema.properties on a metadata root without $ref. Its own schema, after resolving references within the same embedded metadata document, must declare type \"string\" or [\"string\"]. Patterns, combinators, conditionals and literals cannot establish the type. Install rejects a body-derived or extractor-owned source, a reserved host projection, or an indexed source with a narrower audience." },
        "storage": { "$ref": "plugin-manifest-v1.schema.json#/definitions/ManifestPlacement" },
        "claimed_text": { "type": "boolean" },
        "extension": { "type": "string", "pattern": "^[a-z0-9]{1,16}(?![\\s\\S])" },
        "schema": { "$ref": "#/definitions/embeddedSchema" },
        "searchable": { "type": "boolean", "description": "Opt a claimed-text kind into the host background search projection and the claimed-text plans in query.search of the host catalogue. The host checks current scope and field authority at query time. Omission or false leaves the kind out of search." },
        "indexed_fields": {
          "description": "Uses only package field names. Each field explicitly declares a catalogue FieldType for queries, sort keys and extractor outputs. Metadata schemas and values do not determine index types. At install the host rejects any name reserved by generic_item_fields in the host catalogue, including derived declarations.",
          "type": "object", "maxProperties": 32,
          "propertyNames": { "$ref": "#/definitions/localId" },
          "additionalProperties": {
            "type": "object", "additionalProperties": false, "required": ["type", "audience"],
            "properties": {
              "type": { "$ref": "host-catalogue-v2.json#/$defs/FieldType" },
              "audience": { "$ref": "host-catalogue-v2.json#/$defs/FieldAudience" },
              "source": {
                "const": "body_excerpt",
                "description": "Produced by the host index for a claimed-text kind under query.body_excerpt in the host catalogue. Always body-derived."
              },
              "body_derived": {
                "const": true,
                "description": "Mark a field whose value is derived from the body. The host checks body authority before projecting it and excludes it from all persisted member row display parts."
              }
            },
            "if": { "required": ["source"] },
            "then": { "properties": { "type": { "const": "Text" } } }
          }
        },
        "extractors": {
          "description": "Closed selectors over the same claimed-text body. Their outputs must be declared body_derived fields of the types in catalogue query.extractors. Only TextSet outputs may have multiple selectors and all inline selectors for that output must use one separator.",
          "type": "array",
          "maxItems": 8,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "selector",
                  "output",
                  "key"
                ],
                "properties": {
                  "selector": {
                    "const": "frontmatter"
                  },
                  "output": {
                    "$ref": "#/definitions/localId"
                  },
                  "key": {
                    "$ref": "#/definitions/localId"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "selector",
                  "output",
                  "blocks",
                  "max_utf8_bytes"
                ],
                "properties": {
                  "selector": {
                    "const": "first_blocks"
                  },
                  "output": {
                    "$ref": "#/definitions/localId"
                  },
                  "blocks": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 3
                  },
                  "max_utf8_bytes": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 256
                  },
                  "skip_title": {
                    "const": true
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "selector",
                  "output",
                  "marker",
                  "separator",
                  "exclude"
                ],
                "properties": {
                  "selector": {
                    "const": "inline_tags"
                  },
                  "output": {
                    "$ref": "#/definitions/localId"
                  },
                  "marker": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1
                  },
                  "separator": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1
                  },
                  "exclude": {
                    "type": "array",
                    "uniqueItems": true,
                    "maxItems": 5,
                    "items": {
                      "enum": [
                        "code",
                        "links",
                        "addresses",
                        "escapes",
                        "frontmatter"
                      ]
                    }
                  }
                }
              }
            ]
          }
        },
        "device_row_images": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/localId"
          },
          "description": "Declared RowImageRef slots eligible for a checked editing-device snapshot."
        },
        "trash_retention_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3650
        },
        "live_room": { "enum": ["yjs-v1"] },
        "host_create": {
          "description": "Opt in to generic host.item.create. Supply schema-valid initial metadata for an empty item. Install rejects defaults for each host extractor output, the body_excerpt shorthand and every declared device_row_images slot. The host extracts from the empty source before committing the item. Optional after runs a same-package operation or job after the host commit. At install, resolve a job to run_operation and require the entry operation to target this kind with target.field and accept exactly that one required property in a closed input object. Resolve the property reference to ItemRef through the host registry and ignore schema annotations. The host binds the created ref to target.field as the only input.",
          "type": "object",
          "additionalProperties": false,
          "required": ["defaults"],
          "properties": {
            "defaults": { "type": "object", "description": "Package-supplied metadata only. Do not supply a host-derived output, even as null or an empty value." },
            "after": {
              "type": "object",
              "additionalProperties": false,
              "properties": { "operation": { "$ref": "#/definitions/operationId" }, "job": { "$ref": "#/definitions/localId" } },
              "oneOf": [{ "required": ["operation"] }, { "required": ["job"] }]
            }
          }
        },
        "view_snapshots": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/definitions/viewSnapshot"
          }
        },
        "file_format": {
          "$ref": "#/definitions/fileFormat"
        },
        "search_profiles": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/definitions/searchProfile"
          }
        },
        "append_slots": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/definitions/localId"
          },
          "uniqueItems": true
        },
        "execution_target": {
          "const": true,
          "description": "An ordinary item kind that may hold an execution job. Apply the generic file audience fence to every item of this kind, even after attempts and bindings expire."
        }
      },
      "allOf": [
        { "if": { "properties": { "claimed_text": { "const": false } } },
          "then": { "required": ["extension"], "properties": {
            "indexed_fields": { "additionalProperties": { "not": { "required": ["source"] } } }
          } },
          "else": { "properties": { "extension": { "const": "md" } } } },
        { "if": { "required": ["live_room"] },
          "then": { "properties": { "claimed_text": { "const": true } } } },
        { "if": { "required": ["searchable"], "properties": { "searchable": { "const": true } } },
          "then": { "properties": { "claimed_text": { "const": true } } } }
      ]
    },
    "hostMethod": {
      "enum": [
        "item_head",
        "item_range",
        "item_history",
        "item_save",
        "item_trash",
        "item_restore",
        "item_rename",
        "item_rename_status",
        "item_rename_undo",
        "item_purge",
        "empty_trash",
        "collection_create",
        "collection_membership",
        "items_list",
        "items_search",
        "sharing_check",
        "start_job",
        "checkpoint_job",
        "job_status",
        "cancel_job",
        "read_setting",
        "set_setting",
        "request_secret_handle",
        "proxy_request",
        "credential_call",
        "execution_start",
        "execution_status",
        "execution_stop",
        "execution_input",
        "execution_spawn_child",
        "execution_wait",
        "alarm_set",
        "alarm_cancel",
        "item_append",
        "item_view_publish",
        "execution_session_bind",
        "item_view_context",
        "extension_choices"
      ]
    },
    "operation": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "input_schema", "output_schema", "required_capability", "risk", "idempotency", "methods"],
      "properties": {
        "id": { "$ref": "#/definitions/operationId" },
        "title": { "$ref": "#/definitions/label" },
        "input_schema": { "$ref": "#/definitions/embeddedSchema" },
        "output_schema": { "$ref": "#/definitions/embeddedSchema" },
        "required_capability": { "$ref": "plugin-manifest-v1.schema.json#/definitions/ManifestCapability" },
        "risk": {
          "description": "A worker risk declaration grants no resolve-and-dispatch shortcut. The host derives any challenge from the validated effects and material.",
          "allOf": [{ "$ref": "plugin-manifest-v1.schema.json#/definitions/OperationRisk" }]
        },
        "idempotency": { "$ref": "plugin-manifest-v1.schema.json#/definitions/ManifestIdempotency" },
        "target": {
          "oneOf": [
            {
              "type": "object", "additionalProperties": false, "required": ["kind", "field"],
              "properties": {
                "kind": { "$ref": "host-catalogue-v2.json#/$defs/KindId" },
                "field": { "$ref": "#/definitions/localId" }
              }
            },
            {
              "type": "object", "additionalProperties": false, "required": ["kind", "selection_field"],
              "properties": {
                "kind": { "$ref": "host-catalogue-v2.json#/$defs/KindId" },
                "selection_field": { "$ref": "#/definitions/localId" }
              }
            }
          ]
        },
        "creates": { "$ref": "host-catalogue-v2.json#/$defs/KindId" },
        "material_inputs": {
          "description": "Labels by original input key for extra required material. The host writes each into the preview key space input:<key>. Host material occupies a separate key space.",
          "type": "object", "maxProperties": 32,
          "propertyNames": { "$ref": "#/definitions/localId" },
          "additionalProperties": { "$ref": "#/definitions/label" }
        },
        "methods": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/definitions/hostMethod" } },
        "credential_routes": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/definitions/localId" } }
      },
      "allOf": [
        {
          "if": { "properties": { "risk": { "const": "read" } } },
          "then": { "properties": { "idempotency": { "const": "read_only" } } },
          "else": { "properties": { "idempotency": { "enum": ["request_id", "never"] } } }
        },
        {
          "if": { "properties": { "methods": { "contains": { "enum": ["request_secret_handle", "credential_call"] } } } },
          "then": { "required": ["credential_routes"], "properties": { "credential_routes": { "minItems": 1 } } },
          "else": { "properties": { "credential_routes": { "maxItems": 0 } } }
        }
      ]
    },
    "wait": {
      "type": "object", "additionalProperties": false, "required": ["kind"],
      "properties": {
        "kind": { "enum": ["question", "approval", "webhook", "deadline", "execution"] },
        "schema_operation": { "$ref": "#/definitions/operationId" },
        "route": { "$ref": "#/definitions/localId" }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "question" } } }, "then": { "required": ["schema_operation"] },
          "else": { "not": { "required": ["schema_operation"] } } },
        { "if": { "properties": { "kind": { "const": "webhook" } } }, "then": { "required": ["route"] },
          "else": { "not": { "required": ["route"] } } }
      ]
    },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "run_operation", "replayable"],
      "properties": {
        "id": { "$ref": "#/definitions/localId" },
        "run_operation": { "$ref": "#/definitions/operationId" },
        "placement": { "const": "heavy", "description": "Run this job in the on-demand larger plugin VM under the same isolation rules. Omission uses the small plugin VM." },
        "replayable": { "type": "boolean" },
        "waits": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/definitions/wait" } },
        "execution": {
          "const": true
        },
        "alarm": {
          "const": true
        }
      },
      "if": { "properties": { "replayable": { "const": false } } },
      "then": { "properties": { "waits": { "maxItems": 0 } } },
      "allOf": [
        {
          "if": {
            "anyOf": [
              {
                "required": [
                  "execution"
                ]
              },
              {
                "required": [
                  "alarm"
                ]
              }
            ]
          },
          "then": {
            "properties": {
              "replayable": {
                "const": true
              }
            }
          }
        }
      ]
    },
    "webhook": {
      "type": "object", "additionalProperties": false, "required": ["id", "schema_operation", "signing_secret"],
      "properties": {
        "id": { "$ref": "#/definitions/localId" },
        "schema_operation": { "$ref": "#/definitions/operationId" },
        "signing_secret": { "$ref": "#/definitions/localId" }
      }
    },
    "setting": {
      "type": "object", "additionalProperties": false, "required": ["key", "scope", "value_schema", "default"],
      "properties": {
        "key": { "$ref": "#/definitions/localId" },
        "scope": { "enum": ["personal", "space"] },
        "value_schema": { "$ref": "#/definitions/embeddedSchema" },
        "default": {},
        "label": { "$ref": "#/definitions/label" }
      }
    },
    "secret": {
      "type": "object", "additionalProperties": false, "required": ["name", "label", "purpose", "scope", "required"],
      "properties": {
        "name": { "$ref": "#/definitions/localId" }, "label": { "$ref": "#/definitions/label" },
        "purpose": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "scope": { "enum": ["personal", "space"] }, "required": { "type": "boolean" }
      }
    },
    "credentialRoute": {
      "description": "Typed account-server or fixed-site credential route. The host checks the associated permission line, endpoint and profile.",
      "type": "object", "additionalProperties": false,
      "required": ["id", "connection", "profile", "secret", "input_schema", "output_schema"],
      "properties": {
        "id": { "$ref": "#/definitions/localId" },
        "connection": {
          "oneOf": [
            {
              "type": "object", "additionalProperties": false, "required": ["fixed_site"],
              "properties": { "fixed_site": { "$ref": "#/definitions/hostname" } }
            },
            {
              "type": "object", "additionalProperties": false, "required": ["user_server"],
              "properties": { "user_server": { "$ref": "#/definitions/localId" } }
            }
          ]
        },
        "profile": { "$ref": "#/definitions/localId" },
        "secret": { "$ref": "#/definitions/localId" },
        "input_schema": { "$ref": "#/definitions/embeddedSchema" },
        "output_schema": { "$ref": "#/definitions/embeddedSchema" }
      }
    },
    "hostname": {
      "type": "string", "minLength": 1, "maxLength": 253, "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?(?![\\s\\S])",
      "description": "Exact DNS name, checked and normalized by netguard."
    },
    "fileFormat": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/definitions/localId"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      },
      "required": [
        "id",
        "version"
      ]
    },
    "extensionPoint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/definitions/localId"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "kind": {
          "enum": [
            "harness",
            "panel",
            "row_field",
            "action",
            "editor"
          ]
        },
        "input_schema": {
          "$ref": "#/definitions/embeddedSchema"
        },
        "output_schema": {
          "$ref": "#/definitions/embeddedSchema"
        }
      },
      "required": [
        "id",
        "version",
        "kind",
        "input_schema",
        "output_schema"
      ]
    },
    "contribution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "app": {
          "$ref": "#/definitions/localId"
        },
        "point": {
          "$ref": "#/definitions/localId"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "id": {
          "$ref": "#/definitions/localId"
        },
        "kind": {
          "enum": [
            "harness",
            "panel",
            "row_field",
            "action",
            "editor"
          ]
        },
        "operation": {
          "$ref": "#/definitions/operationId"
        },
        "harness": {
          "$ref": "#/definitions/harness"
        },
        "editor": {
          "$ref": "#/definitions/editor"
        }
      },
      "required": [
        "app",
        "point",
        "version",
        "id",
        "kind",
        "operation"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "harness"
              }
            }
          },
          "then": {
            "required": [
              "harness"
            ]
          },
          "else": {
            "properties": {
              "harness": false
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "editor"
              }
            }
          },
          "then": {
            "required": [
              "editor"
            ]
          },
          "else": {
            "properties": {
              "editor": false
            }
          }
        }
      ]
    },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
        },
        "entry": {
          "$ref": "#/definitions/asset"
        },
        "name": {
          "$ref": "#/definitions/label"
        },
        "icon": {
          "$ref": "#/definitions/localId"
        },
        "native_profile": {
          "const": true
        }
      },
      "required": [
        "image",
        "entry",
        "name"
      ],
      "description": "Pinned harness image, entry asset and disclosed native profile access. The host never interprets provider command options."
    },
    "editor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "formats": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/definitions/fileFormat"
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "writes": {
          "const": true
        }
      },
      "required": [
        "formats"
      ]
    },
    "searchProfile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/definitions/localId"
        },
        "operation": {
          "$ref": "#/definitions/operationId"
        },
        "index_job": {
          "$ref": "#/definitions/localId"
        },
        "mode": {
          "enum": [
            "rerank",
            "index"
          ]
        }
      },
      "required": [
        "id",
        "operation",
        "mode"
      ],
      "if": {
        "properties": {
          "mode": {
            "const": "index"
          }
        }
      },
      "then": {
        "required": [
          "index_job"
        ]
      },
      "else": {
        "properties": {
          "index_job": false
        }
      }
    },
    "viewSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/definitions/localId"
        },
        "refresh": {
          "$ref": "#/definitions/operationId"
        }
      },
      "required": [
        "id",
        "refresh"
      ],
      "description": "The owning read operation builds the authorized current native view. Its snapshot publication may only write this regenerable slot."
    }
  }
}
