{
  "version": 2,
  "kind": "app",
  "revision": 1,
  "binds": [
    {
      "id": "collections",
      "source": {
        "type": "list",
        "kind": "collections"
      },
      "fields": [
        "title"
      ],
      "sort": [
        {
          "field": "title",
          "direction": "asc"
        }
      ],
      "window": {
        "size": 100,
        "count": "exact"
      },
      "row": {
        "title": {
          "field": "title"
        }
      },
      "states": {
        "empty": {
          "title": "No collections yet"
        }
      }
    },
    {
      "id": "notes",
      "source": {
        "type": "list",
        "kind": "notes"
      },
      "fields": [
        "title",
        "updated",
        "pinned"
      ],
      "filter": {
        "all": [
          {
            "field": "trashed",
            "op": "eq",
            "value": {
              "literal": false
            }
          }
        ]
      },
      "sort": [
        {
          "field": "updated",
          "direction": "desc"
        }
      ],
      "window": {
        "size": 60,
        "count": "exact"
      },
      "row": {
        "title": {
          "field": "title",
          "fallback": "Untitled"
        },
        "marks": [
          {
            "kind": "icon",
            "icon": "spark",
            "when": {
              "field": "pinned",
              "op": "eq",
              "value": {
                "literal": true
              }
            }
          }
        ],
        "leadingActions": [
          {
            "id": "pin",
            "title": "Pin",
            "icon": "spark",
            "operation": "host.item.patch-metadata",
            "inputs": {
              "item": {
                "row": "id"
              },
              "field": {
                "literal": "pinned"
              },
              "value": {
                "literal": true
              }
            },
            "tone": "warn",
            "fullSwipe": true
          }
        ],
        "menu": [
          {
            "id": "rename",
            "title": "Rename",
            "icon": "edit",
            "operation": "host.item.rename",
            "inputs": {
              "item": {
                "row": "id"
              },
              "title": {
                "prompt": {
                  "title": "Rename note",
                  "initial": {
                    "literal": "Untouched fixture prefill"
                  }
                }
              }
            }
          },
          {
            "id": "choose-destination",
            "title": "Move to collection",
            "icon": "folder",
            "operation": "host.collection.move",
            "inputs": {
              "item": {
                "row": "id"
              },
              "collection": {
                "prompt": {
                  "title": "Move to",
                  "kind": "choice",
                  "options": {
                    "bind": "collections"
                  }
                }
              }
            }
          }
        ]
      },
      "states": {
        "empty": {
          "title": "No notes here",
          "detail": "Create one to get started."
        },
        "error": {
          "title": "Notes could not load",
          "action": {
            "id": "retry",
            "title": "Try again",
            "shell": {
              "reload": true
            }
          }
        }
      }
    }
  ],
  "cache": {
    "templates": "keep"
  },
  "view": {
    "title": "Step 0 Notes authority fixture",
    "root": {
      "type": "stack",
      "children": [
        {
          "type": "list",
          "bind": "notes",
          "selectable": true,
          "selectionMode": "multiple",
          "title": "Notes"
        },
        {
          "type": "button",
          "invoke": {
            "id": "trash-selected",
            "title": "Move to Trash",
            "icon": "trash",
            "operation": "host.item.trash",
            "inputs": {
              "selection_ref": {
                "selection": "notes",
                "set": true
              }
            },
            "role": "destructive"
          }
        }
      ]
    }
  }
}
