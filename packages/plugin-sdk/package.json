{
  "name": "@calternal/plugin-sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./verify-package": "./scripts/verify-package.mjs"
  },
  "scripts": {
    "build": "node scripts/generate-author-types.mjs && tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs && npm run test:author",
    "test:author": "vitest run test/author-v2.test.ts test/build-author-package.test.ts"
  },
  "dependencies": {
    "@calternal/contracts": "*",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  },
  "bin": {
    "calternal-build-plugin": "./scripts/build-author-package.mjs"
  }
}
