{
  "id": "notes-insights",
  "version": "0.1.0",
  "api_version": 1,
  "name": "Notes Insights",
  "description": "Read-only word, character, and line statistics for a note.",
  "dependencies": [
    { "id": "notes", "version": "0.1.0" }
  ],
  "capabilities": ["notes.read"],
  "operations": [
    {
      "id": "notes-insights.summarize",
      "description": "Compute word, character, and line statistics",
      "mutates": false
    }
  ],
  "views": [
    {
      "id": "notes-insights.detail",
      "extension_point": "notes.detail",
      "view": {
        "genui_version": 1,
        "root": {
          "type": "text",
          "id": "notes-insights.placeholder",
          "text": "Summarize a note to see word, character, and line counts."
        }
      }
    }
  ]
}
