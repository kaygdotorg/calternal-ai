    "dark": ["#2d2621", "#26252c", "#212830", "#272119", "#232227", "#1d232a", "#201c17", "#1e1d21", "#191e23"]
  },
  "springs": {
    "$comment": "[damping ratio, response in seconds]; emitted as spring-<name> (a CSS linear() easing) and spring-<name>-ms, capped at 300 ms.",
    "snap": [1, 0.3],
    "morph": [0.86, 0.38],
    "sheet": [0.9, 0.42],
    "card": [0.78, 0.5],
    "bounce": [0.6, 0.34]
