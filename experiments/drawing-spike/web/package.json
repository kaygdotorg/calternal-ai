{
  "name": "drawing-spike-web",
  "private": true,
  "type": "module",
  "description": "Throwaway spike: draws data/declarations.json with data/fixtures.json through generic Svelte views only.",
  "scripts": {
    "data": "node ../decl/emit.ts && node ../data/make-fixtures.mjs",
    "tokens": "node ../../../packages/ui/scripts/build-tokens.mjs",
    "dev": "npm run data && npm run tokens && vite",
    "build": "npm run data && npm run tokens && vite build",
    "shots": "node shots.mjs"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "playwright": "1.65.1",
    "svelte": "5.57.1",
    "vite": "8.3.1"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/common": "^1.5.6",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.1",
    "diff-match-patch": "^1.0.5",
    "lib0": "^0.2.120",
    "y-codemirror.next": "^0.3.6",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33"
  }
}
