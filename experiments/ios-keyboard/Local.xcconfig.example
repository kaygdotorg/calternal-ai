// Copy to Local.xcconfig (untracked) and fill in. Never commit the real file.
// The container app's bundle identifier; the keyboard is this plus ".keyboard".
SPIKE_BUNDLE_ID = com.example.kbspike
// Apple developer team (10 characters).
DEVELOPMENT_TEAM = XXXXXXXXXX
// UDID of the iPhone ./install-on-phone.sh installs on (xcrun devicectl list devices).
PHONE_UDID = 00000000-0000000000000000
