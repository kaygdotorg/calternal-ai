// Build settings for the keyboard spike. Placeholders only: the real team and bundle identifier
// live in Local.xcconfig (untracked; copy Local.xcconfig.example). Without it the project still
// builds for the Simulator.
SPIKE_BUNDLE_ID = com.example.kbspike
DEVELOPMENT_TEAM =
#include? "Local.xcconfig"
// Keychain group shared by the app and the keyboard (replaces an App Group, which the App Store
// Connect key cannot register). Ordinary profiles allow any group under the team prefix.
SPIKE_KEYCHAIN_GROUP = $(DEVELOPMENT_TEAM).$(SPIKE_BUNDLE_ID).shared
