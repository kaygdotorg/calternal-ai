#!/usr/bin/env node
import net from "node:net";
import { spawn } from "node:child_process";
import { fileURLToPath } from "node:url";
import path from "node:path";

const pluginRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..");
const adapter = "/opt/calternal-provider/bin/calternal-provider-claude-code";
let bridge = null;
let control = null;

function waitForBridge(child) {
  return new Promise((resolve, reject) => {
    const timer = setTimeout(() => reject(new Error("egress bridge startup timeout")), 3000);
    child.once("error", error => {
      clearTimeout(timer);
      reject(error);
    });
    child.on("message", message => {
      if (message?.ready) {
        clearTimeout(timer);
        resolve();
      }
    });
    child.once("exit", code => {
      clearTimeout(timer);
      reject(new Error("egress bridge exited (" + code + ")"));
    });
  });
}

function waitForControl(socketPath) {
  return new Promise((resolve, reject) => {
    const socket = net.createConnection({ path: socketPath });
    let stopping = false;
    const timer = setTimeout(() => {
      socket.destroy();
      reject(new Error("run control startup timeout"));
    }, 5000);
    socket.once("error", error => {
      clearTimeout(timer);
      reject(error);
    });
    socket.once("close", () => {
      if (!stopping) spawn("/bin/sh", ["-c", "kill -KILL -1"], { stdio: "ignore" });
    });
    socket.once("connect", () => {
      clearTimeout(timer);
      socket.write("READY\n");
      resolve(() => { stopping = true; socket.end(); });
    });
  });
}

function stop(child) {
  if (!child || child.exitCode !== null) return Promise.resolve();
  return new Promise(resolve => {
    const timer = setTimeout(() => child.kill("SIGKILL"), 500);
    timer.unref();
    child.once("exit", () => {
      clearTimeout(timer);
      resolve();
    });
    child.kill("SIGTERM");
  });
}

try {
  const env = { ...process.env };
  env.CALTERNAL_EGRESS_SOCKET ||= "/run/calternal-egress/proxy.sock";
  bridge = spawn(process.execPath, [path.join(pluginRoot, "programs", "egress-bridge.mjs")], {
    env,
    stdio: ["ignore", "ignore", "ignore", "ipc"],
  });
  await waitForBridge(bridge);
  env.PATH = [path.join(pluginRoot, "bin"), env.PATH || "/usr/bin:/bin"].join(path.delimiter);
  env.CALTERNAL_RUN_CONTROL_SOCKET ||= "/run/calternal-egress/control.sock";
  control = await waitForControl(env.CALTERNAL_RUN_CONTROL_SOCKET);
  const child = spawn(adapter, process.argv.slice(2), { env, stdio: "inherit" });
  const forward = signal => child.kill(signal);
  process.on("SIGTERM", forward);
  process.on("SIGINT", forward);
  const code = await new Promise(resolve => {
    child.once("error", () => resolve(127));
    child.once("exit", (status, signal) => resolve(status ?? (signal ? 128 : 1)));
  });
  await stop(bridge);
  if (control) control();
  process.exitCode = Number(code);
} catch {
  await stop(bridge);
  if (control) control();
  process.exitCode = 1;
}
