{
  "id": "notes-insights",
  "name": "Notes Insights",
  "icon": "chart-bar",
  "version": "0.1.0",
  "api_version": 1,
  "kinds": [],
  "operations": [
    {
      "id": "notes-insights.summarize",
      "input_schema": {
        "type": "object",
        "properties": {
          "note_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          }
        },
        "required": [
          "note_id"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "stats": {
            "type": "object",
            "properties": {
              "words": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              },
              "characters": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              },
              "lines": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              }
            },
            "required": [
              "words",
              "characters",
              "lines"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "stats"
        ],
        "additionalProperties": false
      },
      "required_capability": "space.read",
      "mutates": false,
      "idempotency": "read_only"
    }
  ],
  "collections": [],
  "views": [],
  "attention": [],
  "settings": [],
  "schedules": [],
  "webhooks": [],
  "secrets": [],
  "hooks": [],
  "themes": [],
  "host_calls": [
    "read_item"
  ]
}
