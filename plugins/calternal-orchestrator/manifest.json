{
  "id": "calternal-orchestrator",
  "name": "Threads",
  "icon": "terminal",
  "version": "0.1.0",
  "api_version": 1,
  "kinds": [
    {
      "id": "threads",
      "storage": {
        "folder": "AI",
        "subdirectories": [
          "Chats"
        ]
      },
      "claimed_text": true,
      "schema": {
        "type": "object"
      }
    }
  ],
  "operations": [
    {
      "id": "threads.create",
      "input_schema": {
        "type": "object",
        "properties": {
          "space_id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string",
            "maxLength": 256
          },
          "provider": {
            "type": "string",
            "maxLength": 80
          },
          "mode": {
            "type": "string",
            "enum": [
              "least_access",
              "approve_for_me",
              "full_access"
            ]
          },
          "parent_thread": {
            "type": "string",
            "format": "uuid"
          },
          "spawned_by": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "space_id",
          "title"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object"
      },
      "required_capability": "content.write",
      "mutates": true,
      "risk": "reversible",
      "idempotency": "request_id"
    },
    {
      "id": "threads.list",
      "input_schema": {
        "type": "object",
        "properties": {
          "space_id": {
            "type": "string",
            "format": "uuid"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "parent_thread": {
            "type": "string",
            "format": "uuid"
          },
          "cursor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 524288
          },
          "archived": {
            "type": "boolean"
          }
        },
        "required": [
          "space_id"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object"
      },
      "required_capability": "space.read",
      "mutates": false,
      "risk": "read",
      "idempotency": "read_only"
    },
    {
      "id": "threads.get",
      "input_schema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "space_id": {
            "type": "string",
            "format": "uuid"
          },
          "since": {
            "type": "object",
            "properties": {
              "revision": { "type": "string", "minLength": 1, "maxLength": 80 },
              "actor": {
                "type": "object",
                "description": "Journal attribution can accompany the checkpoint range. It does not select or authorize the read."
              },
              "append": {
                "type": "object",
                "properties": {
                  "base_revision": { "type": "string", "minLength": 1, "maxLength": 80 },
                  "offset": { "type": "integer", "minimum": 0, "maximum": 2097152 },
                  "start": { "type": "integer", "minimum": 0, "maximum": 2097152 },
                  "length": { "type": "integer", "minimum": 0, "maximum": 33280 }
                },
                "required": ["base_revision", "offset", "start", "length"],
                "additionalProperties": false
              }
            },
            "required": ["revision", "append"],
            "additionalProperties": false
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object"
      },
      "required_capability": "space.read",
      "mutates": false,
      "risk": "read",
      "idempotency": "read_only",
      "target": {
        "kind": "threads",
        "field": "id"
      }
    },
    {
      "id": "threads.send",
      "input_schema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "space_id": {
            "type": "string",
            "format": "uuid"
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384
          },
          "provider": {
            "type": "string",
            "maxLength": 80
          },
          "model": {
            "type": "string",
            "maxLength": 128
          },
          "mode": {
            "type": "string",
            "enum": [
              "least_access",
              "approve_for_me",
              "full_access"
            ]
          }
        },
        "required": [
          "id",
          "message"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object"
      },
      "required_capability": "plugins.use",
      "mutates": true,
      "risk": "external",
      "idempotency": "request_id",
      "target": {
        "kind": "threads",
        "field": "id"
      }
    },
    {
      "id": "threads.stop",
      "input_schema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
