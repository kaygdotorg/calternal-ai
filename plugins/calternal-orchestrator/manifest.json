      },
      "output_schema": {
        "type": "object"
      },
      "required_capability": "content.write",
      "mutates": true,
      "risk": "reversible",
      "idempotency": "request_id",
      "target": {
        "kind": "threads",
        "field": "id"
      }
    },
    {
