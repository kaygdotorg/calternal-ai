{
  "id": "calternal-plugin-guide",
  "name": "Calternal Plugin Guide",
  "version": "0.1.0",
  "icon": "book",
  "api_version": 1,
  "kinds": [
    {
      "id": "plugin-guides",
      "schema": {
        "type": "object"
      },
      "storage": {
        "folder": "Plugin Guide"
      },
      "claimed_text": true
    }
  ],
  "operations": [
    {
      "id": "calternal-plugin-guide.explain",
      "input_schema": {
        "type": "object",
        "properties": {
          "topic": {
            "enum": [
              "reference",
              "walkthrough",
              "skill"
            ]
          }
        },
        "required": [
          "topic"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object"
      },
      "required_capability": "space.read",
      "mutates": false,
      "idempotency": "read_only",
      "risk": "read"
    },
    {
      "id": "calternal-plugin-guide.scaffold",
      "input_schema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object"
      },
      "required_capability": "space.read",
      "mutates": false,
      "idempotency": "read_only",
      "risk": "read"
    },
    {
      "id": "calternal-plugin-guide.check",
      "input_schema": {
        "type": "object",
        "properties": {
          "manifest": {
            "type": "object"
          }
        },
        "required": [
          "manifest"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object"
      },
      "required_capability": "space.read",
      "mutates": false,
      "idempotency": "read_only",
      "risk": "read"
    },
    {
      "id": "calternal-plugin-guide.publish",
      "input_schema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object"
      },
      "required_capability": "content.write",
      "mutates": true,
      "idempotency": "request_id",
      "risk": "reversible"
    }
  ],
  "collections": [],
  "views": [],
  "attention": [],
  "settings": [],
  "schedules": [],
  "webhooks": [],
  "secrets": [],
  "hooks": [],
  "themes": [],
  "host_calls": [
    "write_item"
  ]
}
